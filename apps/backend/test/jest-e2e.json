{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@capabilities/(.*)$": "<rootDir>/../src/capabilities/$1",
    "^@shared/(.*)$": "<rootDir>/../src/shared/$1",
    "^@ibm-talent-bridge/shared-types$": "<rootDir>/../../../packages/shared-types/src/index.ts"
  }
}
