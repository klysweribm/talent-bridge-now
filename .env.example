# ─────────────────────────────────────────────
# IBM TALENT BRIDGE — Variables de Entorno
# Copiar a .env y completar los valores reales
# NUNCA commitear el archivo .env al repositorio
# ─────────────────────────────────────────────

# ─── Puertos (cambiar si hay conflicto con otras apps locales) ────
BACKEND_PORT=3000
FRONTEND_PORT=5174

# App
NODE_ENV=development
PORT=${BACKEND_PORT}
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# ─── Auth / JWT ───────────────────────────────
JWT_SECRET=change_me_min_32_chars_secret_key
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ─── Rate limiting (backend, @nestjs/throttler) ───
# TTL en segundos y máximo de requests por ventana. El backend debe leerlas
# con fallback (ej. vía ConfigService) si no están definidas.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Frontend (Vite) ──────────────────────────
# Prefijo relativo: en Docker/local el proxy de Vite reenvía /api al backend
# (ver apps/frontend/vite.config.ts); en producción, el host del backend real.
VITE_API_URL=/api/v1

# ─── MongoDB ──────────────────────────────────
# Local (backend corriendo fuera de Docker contra el Mongo del compose):
# usar la misma contraseña que MONGO_INITDB_ROOT_PASSWORD. Dentro de Docker,
# docker-compose.yml sobreescribe esta variable con el host `mongodb`.
MONGODB_URI=mongodb://admin:<define-una-contraseña-local>@localhost:27017/talent-bridge?authSource=admin
# Producción (IBM Cloud → Databases for MongoDB → Credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<host>/<dbname>?authSource=admin

# ─── watsonx.ai (análisis de CV — CvAnalysisPort) ─────
# Obtener desde: IBM Cloud → watsonx.ai → Projects → tu proyecto → API key.
# Región a validar: watsonx.ai puede no estar disponible en br-sao (ver
# docs/architecture/README.md → "Abierto"); si no lo está, usar la región
# más cercana disponible (ej. us-south) solo para esta llamada puntual.
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_API_KEY=
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ─── IBM Cloud Object Storage (COS, br-sao) ──
# Obtener desde: IBM Cloud → Object Storage → Service credentials
COS_ENDPOINT=https://s3.br-sao.cloud-object-storage.appdomain.cloud
COS_API_KEY=
COS_INSTANCE_CRN=crn:v1:bluemix:public:cloud-object-storage:global:a/<account_id>:<instance_id>::
COS_BUCKET_CVS=talent-bridge-cvs

# ─── SMTP (EmailSenderPort — OTP, invitaciones, feedback, reportes) ──
# Relay SMTP corporativo (a validar, ver docs/architecture/README.md → "Abierto").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=talent-bridge@ibm.com

# ─── IBM App ID (Fase 2 — SSO) ────────────────
# Dejar vacío en MVP. Fase 2: App ID está en camino de reemplazo por IBM
# Security Verify — verificar cuál sigue vigente antes de activar este bloque.
# APPID_TENANT_ID=
# APPID_CLIENT_ID=
# APPID_SECRET=
# APPID_OAUTH_SERVER_URL=https://<region>.appid.cloud.ibm.com/oauth/v4/<tenant_id>

# ─── Slack ────────────────────────────────────
# Obtener desde: Slack App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>

# ─── Desarrollo Local (Docker Compose) ────────
# Solo usar en local — no aplica en producción
# Elige una contraseña segura para tu entorno local y defínela en .env (nunca commitear .env)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=<define-una-contraseña-local>
MONGO_PORT=27017

# ─── Tests de integración (docker-compose.test.yml) ───
MONGO_INITDB_ROOT_PASSWORD_TEST=<contraseña-para-tests>
