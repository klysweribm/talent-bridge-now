FROM node:22-alpine

# Puerto configurable en build time — default 5174
ARG FRONTEND_PORT=5174
ENV VITE_PORT=${FRONTEND_PORT}

# WORKDIR replica la ruta del monorepo (apps/frontend) para que el alias de
# Vite hacia ../../packages/shared-types resuelva igual dentro y fuera del
# contenedor (ver docker-compose.yml: monta ./packages en /app/packages).
WORKDIR /app/apps/frontend

COPY package*.json ./
COPY package-lock.json ./
RUN npm ci

COPY . .

EXPOSE ${FRONTEND_PORT}

# Vite usa VITE_PORT (leído en vite.config.ts) y escucha en 0.0.0.0
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
