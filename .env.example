# ─────────────────────────────────────────────
# IBM TALENT BRIDGE — Variables de Entorno
# Copiar a .env y completar los valores reales
# NUNCA commitear el archivo .env al repositorio
# ─────────────────────────────────────────────

# ─── Puertos (cambiar si hay conflicto con otras apps locales) ────
BACKEND_PORT=3000
FRONTEND_PORT=5174

# App
NODE_ENV=development
PORT=${BACKEND_PORT}
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# ─── Auth / JWT ───────────────────────────────
JWT_SECRET=change_me_min_32_chars_secret_key
JWT_EXPIRATION=1h
# Login de desarrollo (POST /auth/dev-login + seed de usuarios demo). Falla
# cerrado: solo con el valor exacto `true`. NUNCA en producción (se ignora si
# NODE_ENV=production). Se elimina cuando AUTH-2 (OTP) reemplace la emisión.
AUTH_DEV_LOGIN_ENABLED=true

# Retención (días) de auth_events (login/logout con ip y userAgent = datos personales).
# Índice TTL sobre `at`; defecto 90 si falta o no es un entero > 0.
AUTH_EVENT_RETENTION_DAYS=90

# ─── FlowLog (observabilidad de flujo, solo depuración) ───
# Imprime en terminal request -> adapters -> response. Oculta secretos pero MUESTRA
# emails/nombres a propósito. Falla cerrado: solo con `true` exacto y se ignora
# si NODE_ENV=production. Apagado por defecto: para depurar, ponlo en `true` en tu
# `.env` local y recrea el backend (`podman-compose up -d --force-recreate backend`).
FLOW_LOG_ENABLED=false

# ─── Rate limiting (backend, @nestjs/throttler) ───
# TTL en segundos y máximo de requests por ventana. El backend debe leerlas
# con fallback (ej. vía ConfigService) si no están definidas.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Frontend (Vite) ──────────────────────────
# Prefijo relativo: en Docker/local el proxy de Vite reenvía /api al backend
# (ver apps/frontend/vite.config.ts); en producción, el host del backend real.
VITE_API_URL=/api/v1
# Cierre por inactividad: tras IDLE_TIMEOUT s sin actividad aparece un aviso con
# cuenta atrás de IDLE_WARNING s; al llegar a cero se cierra la sesión.
# Enteros positivos, y WARNING debe ser menor que TIMEOUT.
VITE_IDLE_TIMEOUT_SECONDS=360
VITE_IDLE_WARNING_SECONDS=60

# ─── MongoDB ──────────────────────────────────
# Local (backend corriendo fuera de Docker contra el Mongo del compose):
# usar la misma contraseña que MONGO_INITDB_ROOT_PASSWORD. Dentro de Docker,
# docker-compose.yml sobreescribe esta variable con el host `mongodb`.
MONGODB_URI=mongodb://admin:<define-una-contraseña-local>@localhost:27017/talent-bridge?authSource=admin
# Producción (IBM Cloud → Databases for MongoDB → Credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<host>/<dbname>?authSource=admin

# Integraciones externas (watsonx.ai, COS, SMTP, Slack, App ID): sus variables se
# añaden aquí junto con su adapter (ver docs/architecture/README.md).

# ─── Desarrollo Local (Docker Compose) ────────
# Solo usar en local — no aplica en producción
# Elige una contraseña segura para tu entorno local y defínela en .env (nunca commitear .env)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=<define-una-contraseña-local>
MONGO_PORT=27017

# ─── Tests de integración (docker-compose.test.yml) ───
MONGO_INITDB_ROOT_PASSWORD_TEST=<contraseña-para-tests>
