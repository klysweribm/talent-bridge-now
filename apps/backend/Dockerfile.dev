FROM node:22-alpine

# Puerto configurable en build time — default 3000
ARG BACKEND_PORT=3000
ENV PORT=${BACKEND_PORT}

# WORKDIR replica la ruta del monorepo (apps/backend) para que el alias de
# tsconfig hacia ../../packages/shared-types resuelva igual dentro y fuera del
# contenedor (ver docker-compose.yml: monta ./packages en /app/packages).
WORKDIR /app/apps/backend

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE ${BACKEND_PORT}

CMD ["npm", "run", "start:dev"]
