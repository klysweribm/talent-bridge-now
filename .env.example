# ═════════════════════════════════════════════════════════════
# IBM TALENT BRIDGE — Variables de entorno
# Copiar a .env y completar los valores reales.
# NUNCA commitear el archivo .env al repositorio.
#
# Organización (mantener el mismo orden en .env):
#   1. COMPARTIDAS      puertos y URLs que usan backend, frontend y compose
#   2. BACKEND          NestJS (apps/backend)
#   3. FRONTEND         Vite (apps/frontend) — solo variables VITE_*
#   4. INFRAESTRUCTURA  MongoDB y tests de integración (docker-compose)
# ═════════════════════════════════════════════════════════════


# ═════════════════════════════════════════════════════════════
# 1. COMPARTIDAS
# ═════════════════════════════════════════════════════════════

# Puertos (cambiar si hay conflicto con otras apps locales)
BACKEND_PORT=3000
FRONTEND_PORT=5174

# Entorno y URLs
NODE_ENV=development
PORT=${BACKEND_PORT}
FRONTEND_URL=http://localhost:${FRONTEND_PORT}


# ═════════════════════════════════════════════════════════════
# 2. BACKEND (NestJS)
# ═════════════════════════════════════════════════════════════

# ─── Auth / JWT ───────────────────────────────
JWT_SECRET=change_me_min_32_chars_secret_key
JWT_EXPIRATION=1h
# Login de desarrollo (POST /auth/dev-login + seed de usuarios demo). Falla
# cerrado: solo con el valor exacto `true`. NUNCA en producción (se ignora si
# NODE_ENV=production). Se elimina cuando AUTH-2 (OTP) reemplace la emisión.
AUTH_DEV_LOGIN_ENABLED=true
# Retención (días) de auth_events (login/logout con ip y userAgent = datos personales).
# Índice TTL sobre `at`; defecto 90 si falta o no es un entero > 0.
AUTH_EVENT_RETENTION_DAYS=90

# ─── Rate limiting (@nestjs/throttler) ────────
# TTL en segundos y máximo de requests por ventana. El backend debe leerlas
# con fallback (ej. vía ConfigService) si no están definidas.
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── Base de datos (MongoDB) ──────────────────
# Local (backend corriendo fuera de Docker contra el Mongo del compose):
# usar la misma contraseña que MONGO_INITDB_ROOT_PASSWORD. Dentro de Docker,
# docker-compose.yml sobreescribe esta variable con el host `mongodb`.
MONGODB_URI=mongodb://admin:<define-una-contraseña-local>@localhost:27017/talent-bridge?authSource=admin
# Producción (IBM Cloud → Databases for MongoDB → Credentials):
# MONGODB_URI=mongodb+srv://<user>:<password>@<host>/<dbname>?authSource=admin

# ─── Seed de datos de demo ────────────────────
# Seed de bench (BENCH-1): al arrancar el backend siembra `bench_resources` desde un
# JSON mock (30 recursos). Falla cerrado: solo con el valor exacto `true`. Se ignora
# si NODE_ENV=production. El upsert es idempotente por benchCode.
BENCH_SEED_ENABLED=true

# ─── FlowLog (observabilidad de flujo, solo depuración) ───
# Imprime en terminal request -> adapters -> response. Oculta secretos pero MUESTRA
# emails/nombres a propósito. Falla cerrado: solo con `true` exacto y se ignora
# si NODE_ENV=production. Apagado por defecto: para depurar, ponlo en `true` en tu
# `.env` local y recrea el backend (`podman-compose up -d --force-recreate backend`).
FLOW_LOG_ENABLED=false

# ─── IA: IBM Consulting Advantage (ICA) ───────
# Proveedor de IA. Valores válidos: `ica` | `fake`; cualquier otro valor apaga la IA.
# `fake` devuelve respuestas fijas marcadas como demo (para desarrollo y tests);
# nunca usar con NODE_ENV=production. No hay respaldo automático: si ICA falla,
# la consulta de IA falla y se informa el error.
AI_PROVIDER=ica
# URL base de la API de ICA.
ICA_API_URL=https://api.servicesessentials.ibm.com/v1
# Clave de API (SECRETO). Se genera en ICA → Settings → API Keys → ICA APIs.
# Definirla solo en .env local o en secretos de CI; nunca commitearla.
# Vacía = IA deshabilitada (la app arranca igual).
ICA_API_KEY=
# Modelo a usar (el anterior claude-haiku-4-5 ya no existe en ICA).
ICA_MODEL_ID=claude-haiku-5-5
# Tope de tokens de salida por respuesta. El modelo admite hasta 128000, pero ICA genera ~150
# tokens/s: un tope alto no cuesta nada si el modelo no lo usa, y evita JSON truncado
# (`finish_reason: length`). El límite real es el tiempo: ver los dos timeouts de abajo.
ICA_MAX_TOKENS=8192
# Timeout por llamada a ICA, en milisegundos.
ICA_TIMEOUT_MS=60000
# Reintentos ante fallo: intentos máximos y espera base/máxima (backoff), en ms.
AI_RETRY_MAX_ATTEMPTS=3
AI_RETRY_BASE_MS=1000
AI_RETRY_MAX_MS=10000
# Tope de tiempo total por consulta de IA (incluye reintentos), en milisegundos.
AI_TOTAL_TIMEOUT_MS=90000

# ─── Candidatos: carga de CV (CAND-2) ─────────
# Tamaño máximo de un archivo de CV, en bytes (5242880 = 5 MiB). Es el límite REAL:
# el servidor rechaza con 400 lo que lo exceda. Mantener igual que VITE_CV_MAX_FILE_BYTES.
CV_MAX_FILE_BYTES=5242880

# Integraciones externas (watsonx.ai, COS, SMTP, Slack, App ID): sus variables se
# añaden en esta sección junto con su adapter (ver docs/architecture/README.md).


# ═════════════════════════════════════════════════════════════
# 3. FRONTEND (Vite) — solo variables VITE_*
# Se incrustan en el código al compilar y las ve cualquiera: nunca poner secretos.
# ═════════════════════════════════════════════════════════════

# ─── API ──────────────────────────────────────
# Prefijo relativo: en Docker/local el proxy de Vite reenvía /api al backend
# (ver apps/frontend/vite.config.ts); en producción, el host del backend real.
VITE_API_URL=/api/v1

# ─── Sesión ───────────────────────────────────
# Cierre por inactividad: tras IDLE_TIMEOUT s sin actividad aparece un aviso con
# cuenta atrás de IDLE_WARNING s; al llegar a cero se cierra la sesión.
# Enteros positivos, y WARNING debe ser menor que TIMEOUT.
VITE_IDLE_TIMEOUT_SECONDS=360
VITE_IDLE_WARNING_SECONDS=60

# ─── Candidatos: carga de CV (CAND-2) ─────────
# Tope de tamaño del CV validado en el cliente. Es solo comodidad de interfaz: el límite
# real lo aplica el backend con CV_MAX_FILE_BYTES. Mantener ambas iguales.
VITE_CV_MAX_FILE_BYTES=5242880
# Interruptor mock-first de la infraestructura de candidatos ('true' | 'false').
# Con `true` no se llama al backend y NO se guarda nada. Poner `false` para el backend real.
VITE_CANDIDATES_USE_MOCK=true


# ═════════════════════════════════════════════════════════════
# 4. INFRAESTRUCTURA (docker-compose)
# ═════════════════════════════════════════════════════════════

# ─── MongoDB (desarrollo local) ───────────────
# Solo usar en local — no aplica en producción.
# Elige una contraseña segura para tu entorno local y defínela en .env (nunca commitear .env).
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=<define-una-contraseña-local>
MONGO_PORT=27017
# Usuario de Mongo de solo lectura (rol `read` sobre talent-bridge) para inspeccionar datos.
# Se crea al inicializar un volumen vacío (docker/mongo-init). Vacía = no se crea.
MONGO_READONLY_USER=tb_reader
MONGO_READONLY_PASSWORD=<define-una-contraseña-local-distinta-de-la-root>

# ─── Tests de integración (docker-compose.test.yml) ───
MONGO_INITDB_ROOT_PASSWORD_TEST=<contraseña-para-tests>
