# ─────────────────────────────────────────────
# IBM TALENT BRIDGE — Variables de Entorno
# Copiar a .env y completar los valores reales
# NUNCA commitear el archivo .env al repositorio
# ─────────────────────────────────────────────

# ─── Puertos (cambiar si hay conflicto con otras apps locales) ────
BACKEND_PORT=3000
FRONTEND_PORT=5174

# App
NODE_ENV=development
PORT=${BACKEND_PORT}
FRONTEND_URL=http://localhost:${FRONTEND_PORT}

# ─── Auth / JWT ───────────────────────────────
JWT_SECRET=change_me_min_32_chars_secret_key
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# ─── MongoDB (IBM Cloud) ──────────────────────
# Obtener desde: IBM Cloud → Databases → MongoDB → Credentials
MONGODB_URI=mongodb+srv://<user>:<password>@<host>/<dbname>?authSource=admin

# ─── Redis (IBM Cloud) ────────────────────────
# Obtener desde: IBM Cloud → Databases → Redis → Credentials
REDIS_URL=rediss://<user>:<password>@<host>:<port>/0

# ─── IBM Watson NLU ───────────────────────────
# Obtener desde: IBM Cloud → Watson NLU → Manage → Credentials
WATSON_NLU_URL=https://api.us-south.natural-language-understanding.watson.cloud.ibm.com
WATSON_NLU_API_KEY=
WATSON_NLU_VERSION=2021-08-01

# ─── IBM Cloud Object Storage (COS) ──────────
# Obtener desde: IBM Cloud → Object Storage → Service credentials
COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
COS_API_KEY=
COS_INSTANCE_CRN=crn:v1:bluemix:public:cloud-object-storage:global:a/<account_id>:<instance_id>::
COS_BUCKET_CVS=talent-bridge-cvs

# ─── IBM Event Notifications ──────────────────
# Obtener desde: IBM Cloud → Event Notifications → Service credentials
EVENT_NOTIFICATIONS_GUID=
EVENT_NOTIFICATIONS_API_KEY=
EVENT_NOTIFICATIONS_URL=https://us-south.event-notifications.cloud.ibm.com

# ─── IBM App ID (Fase 2 — SSO) ────────────────
# Dejar vacío en MVP. Activar en Fase 2.
APPID_TENANT_ID=
APPID_CLIENT_ID=
APPID_SECRET=
APPID_OAUTH_SERVER_URL=https://<region>.appid.cloud.ibm.com/oauth/v4/<tenant_id>

# ─── Slack ────────────────────────────────────
# Obtener desde: Slack App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<T>/<B>/<token>

# ─── Desarrollo Local (Docker Compose) ────────
# Solo usar en local — no aplica en producción
# Elige una contraseña segura para tu entorno local y defínela en .env (nunca commitear .env)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=<define-una-contraseña-local>
REDIS_PASSWORD=<define-una-contraseña-local>
MONGO_PORT=27017
REDIS_PORT=6379

# ─── Tests de integración (docker-compose.test.yml) ───
MONGO_INITDB_ROOT_PASSWORD_TEST=<contraseña-para-tests>
REDIS_PASSWORD_TEST=<contraseña-para-tests>
